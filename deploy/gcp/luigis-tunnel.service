[Unit]
Description=Luigi's temporary HTTPS demo tunnel
After=network-online.target luigis.service
Wants=network-online.target luigis.service

[Service]
Type=simple
User=luigis
Group=luigis
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --edge-ip-version 6 --protocol http2 --url http://127.0.0.1:3000
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
